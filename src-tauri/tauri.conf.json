{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LocalLLM",
  "version": "0.1.12",
  "identifier": "com.localllm.llamacpp",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:pi-sidecar && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "LocalLLM",
        "width": 1180,
        "height": 780,
        "minWidth": 720,
        "minHeight": 560,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/pi"
    ],
    "resources": {
      "binaries/theme": "theme",
      "binaries/assets": "assets",
      "binaries/export-html": "export-html",
      "binaries/docs": "docs",
      "binaries/examples": "examples",
      "binaries/package.json": "package.json",
      "binaries/README.md": "README.md",
      "binaries/CHANGELOG.md": "CHANGELOG.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
